import logging
import argparse
from pathlib import Path

from GraphGeneration import get_ica_graph
from Utils import load_event_features, save_edges

logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(levelname)s - %(message)s")

if __name__ == "__main__":    
    # Parsing the arguments that'll be used on the ICA method
    parser = argparse.ArgumentParser(description ='Generate the ICA graphs')
    parser.add_argument('--hyperparameters',  type=int, nargs=3, help='Number of neighbors in ICA graph, desired dimensionality, and random state')
    parser.add_argument('--whiten', type=str, choices=['0', 'unit-variance', 'arbitrary-variance'], help='ICA whiten hyperparameter')
    parser.add_argument('--fun', type=str, choices=['logcosh', 'exp', 'cube'], help='ICA fun hyperparameter')
    parser.add_argument('--dataset_path', type=str, help='The path for the current dataset file')
    parser.add_argument("--output_dir", type=str, default="./GeneratedGraphs/ICA", help="Directory to save the output.")
    args = parser.parse_args()

    # Getting the dataset specifications
    dataset_path = args.dataset_path
    dataset_name = Path(dataset_path).stem
    output_dir = args.output_dir

    # Acquiring from arguments the method's hyperparameters
    k_ica, dim, rnd_state = args.hyperparameters
    whiten = False if args.whiten == '0' else args.whiten
    functional = args.fun
    
    # Loading the representation and obtaining the ICA graph from it
    final_representation = load_event_features(dataset_name, 'final')
    ica_graph = get_ica_graph(final_representation, k_ica, whiten, functional, dim, rnd_state)

    output_file = Path(output_dir) / dataset_name / f"ica_edges_{k_ica}_{whiten}_{functional}.pkl"
    save_edges(ica_graph, output_file)

